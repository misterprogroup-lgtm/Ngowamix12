# Database - PostgreSQL (local ou Neon/Supabase sur Vercel)
DATABASE_URL="postgresql://user:password@localhost:5432/ngowamix"

JWT_SECRET="change-this-to-a-random-secure-string-at-least-32-chars"
APP_URL="http://localhost:3000"
GOOGLE_SITE_VERIFICATION=""  # À remplir avec le code Google Search Console
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
MONEROO_API_KEY=""
MONEROO_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_NAME="Ngowamix"
PREMIUM_PRICE=5000
PREMIUM_CURRENCY="XOF"
PREMIUM_DOWNLOAD_QUOTA=30
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Web Push (VAPID) - générer avec: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@ngowamix.com"

# Email (Resend) - réinitialisation mot de passe
RESEND_API_KEY=""
EMAIL_FROM="Ngowamix <noreply@ngowamix.com>"
RESEND_WEBHOOK_SECRET=""      # Secret pour sécuriser le webhook entrant (inbound)

# Uploadthing - upload de fichiers (alternative)
# Créer un compte sur https://uploadthing.com, copier le token depuis le Dashboard
UPLOADTHING_TOKEN=""

# Storage: Vercel Blob (prioritaire) — https://vercel.com/docs/storage/vercel-blob
# Créer un store Blob sur Vercel, copier le token read-write ici
BLOB_READ_WRITE_TOKEN=""

# Google OAuth - Connexion avec Google
# Créer un projet sur https://console.cloud.google.com/apis/credentials
# Ajouter les URLs de votre site aux origines JavaScript autorisées
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# S3-compatible storage (AWS S3, Cloudflare R2, etc.)
# Fallback si Vercel Blob n'est pas configuré
S3_ENDPOINT=""           # https://<account>.r2.cloudflarestorage.com (Cloudflare R2)
S3_REGION="auto"         # auto pour R2, ou la région AWS (ex: eu-west-3)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="ngowamix"
S3_PUBLIC_URL=""         # Domaine personnalisé optionnel (ex: https://cdn.ngowamix.com)
